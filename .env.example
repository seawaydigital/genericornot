# ── Required ───────────────────────────────────────────────────────────────
# Neon in production. A local Postgres URL (localhost/127.0.0.1) also works:
# the app switches to node-postgres automatically for local hosts.
DATABASE_URL="postgresql://user:password@localhost:5432/genericornot"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Production: https://genericornot.com (no trailing slash, no www)
NEXTAUTH_URL="http://localhost:3000"

# Canonical site URL used for metadata, sitemap and OG images.
# Optional; defaults to https://genericornot.com
NEXT_PUBLIC_SITE_URL="https://genericornot.com"

# ── Sign-in providers ──────────────────────────────────────────────────────
# Each is optional. A provider's button appears only when its vars are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# Email magic link via Resend (free tier: 3K emails/month).
# Sign up at https://resend.com, verify genericornot.com, create an API key.
RESEND_API_KEY=""
EMAIL_FROM="GenericOrNot <noreply@genericornot.com>"

# ── Optional ───────────────────────────────────────────────────────────────
# logo.dev publishable token for brand logos (free tier: 500K req/month).
NEXT_PUBLIC_LOGO_DEV_TOKEN=""

# Minutes a new account must exist before its votes count. 0 = off (default).
# Raise it (e.g. 60) only if you see coordinated voting from fresh accounts.
VOTE_MIN_ACCOUNT_AGE_MINUTES="0"

# Force a database driver: "pg" (node-postgres) or "neon". Leave empty to
# auto-detect from DATABASE_URL.
DATABASE_ADAPTER=""
